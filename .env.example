# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Gemini API Key for AI features (if using AI functionality)
GEMINI_API_KEY=your_gemini_api_key_here

# Production Environment Variables
NODE_ENV=production
VITE_APP_NAME=AG Builders Website
VITE_APP_VERSION=1.0.0

# Analytics (Optional)
# VITE_GOOGLE_ANALYTICS_ID=your_google_analytics_id
# VITE_FACEBOOK_PIXEL_ID=your_facebook_pixel_id

# Contact Information (Override constants.tsx values if needed)
# VITE_CONTACT_PHONE=1234567890
# VITE_CONTACT_EMAIL=contact@agbuilders.com
# VITE_WHATSAPP_NUMBER=1234567890